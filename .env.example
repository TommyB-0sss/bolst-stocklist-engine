# .env.example — required environment variables (NO secret VALUES here).
#
# Local dev:  copy to .env and fill in. .env is gitignored.
# Cloud (Claude Cloud Routines):  set these as Routine "secrets" instead of
#   committing a .env. setup.sh + auth.py read them from the environment.

# --- Microsoft Graph (Entra app, single-tenant, public client) ---
BOLST_AZURE_CLIENT_ID=
BOLST_AZURE_TENANT_ID=
BOLST_AZURE_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
BOLST_AZURE_SCOPES=Mail.Read Mail.Send Mail.ReadWrite

# --- Email routing ---
# Report is sent FROM Tom's Outlook (Graph sendMail under his OAuth grant).
BOLST_REPORT_SENDER=tom@bolstpropertygroup.com.au
# Report recipient. BUILD PHASE = Inam (manual review). Flip to Tom when
# mature. This env var is the source of truth — NOT delivery.yml.
BOLST_REPORT_RECIPIENT=inam@meetapex.ai
# Evening One Part prompt recipient (Tom replies on this thread).
BOLST_ONE_PART_RECIPIENT=tom@bolstpropertygroup.com.au

# --- Cloud (Routines) ONLY: OAuth token cache injected as a secret ---
# The full contents of .credentials/token.json (MSAL SerializableTokenCache,
# created locally by the first device-code sign-in). setup.sh writes it to
# .credentials/token.json on the VM. Never commit. Re-capture before the
# refresh token's ~90-day window lapses.
BOLST_GRAPH_TOKEN_JSON=

# --- Dormant: Domain.com.au API (SUPERSEDED 2026-05-23 by the REA CSV
# path; not used in production). Leave unset. ---
# DOMAIN_CLIENT_ID=
# DOMAIN_CLIENT_SECRET=
