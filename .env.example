# .env.example — required environment variables (NO secret VALUES here).
#
# Local dev:  copy to .env and fill in. .env is gitignored.
# Cloud (Claude Cloud Routines):  set these as Routine "secrets" instead of
#   committing a .env. setup.sh + auth.py read them from the environment.

# --- Microsoft Graph (Entra app registration in Bolst's tenant) ---
BOLST_AZURE_CLIENT_ID=
BOLST_AZURE_TENANT_ID=
# Must be tenant-specific (never /common) — app-only auth requires it.
BOLST_AZURE_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
# Delegated scopes (legacy device-code mode only; app-only uses .default).
BOLST_AZURE_SCOPES=Mail.Read Mail.Send Mail.ReadWrite

# --- APP-ONLY auth (preferred since 2026-09, RUNBOOK §9) ---
# The engine authenticates as the app itself (client credentials) and works
# on /users/<BOLST_MAILBOX>/... with APPLICATION permissions Mail.Read +
# Mail.Send. No user sign-in, no refresh token: Tom's password resets can no
# longer revoke it. Set ONE of the credential forms below. Decision 2026-09-11:
# client secret at Microsoft's 24-month portal maximum for now; the certificate
# form stays available (wins if both are set).
#
# Certificate form (deferred): base64 (ONE line) of a PEM bundle = private key + certificate.
#   openssl req -x509 -newkey rsa:2048 -sha256 -days 1095 -nodes #     -subj "/CN=bolst-stocklist-engine" #     -keyout .credentials/bolst-engine.key -out .credentials/bolst-engine.cer
#   cat .credentials/bolst-engine.key .credentials/bolst-engine.cer > .credentials/bolst-engine.pem
#   base64 -w0 .credentials/bolst-engine.pem > .credentials/bolst-engine.pem.b64
# Upload bolst-engine.cer to the app registration (Certificates & secrets).
# The thumbprint and expiry are derived from the bundle automatically.
# BOLST_AZURE_CLIENT_CERT_PEM_B64=
# Local-dev alternative to the B64 var: path to the same PEM bundle.
# BOLST_AZURE_CLIENT_CERT_PEM_PATH=.credentials/bolst-engine.pem
# Only needed if the PEM bundle holds the private key WITHOUT the certificate:
# BOLST_AZURE_CLIENT_CERT_THUMBPRINT=
#
# CHOSEN FORM: client secret (Entra > Certificates & secrets > Client secrets,
# Expires = 24 months). Give the expiry date from the portal so every run logs
# the countdown and warns at 60 days.
BOLST_AZURE_CLIENT_SECRET=
BOLST_AZURE_CLIENT_SECRET_EXPIRES=
#
# Mailbox to read from and send as in app-only mode. Defaults to
# BOLST_REPORT_SENDER, so normally leave unset.
# BOLST_MAILBOX=tom@bolstpropertygroup.com.au
# Force a mode for debugging: app | delegated | auto (default auto = app if a
# credential above is set, else delegated).
# BOLST_AUTH_MODE=auto

# --- Email routing ---
# Report is sent FROM Tom's Outlook (Graph sendMail under his OAuth grant).
BOLST_REPORT_SENDER=tom@bolstpropertygroup.com.au
# Report recipient(s) — single address or comma-separated list (all on the
# To: line). This env var is the source of truth — NOT delivery.yml.
# Live = Tom + reps; append Aaron Wilson + Howard Rock when their addresses
# are confirmed, e.g.:
#   BOLST_REPORT_RECIPIENT=tom@bolstpropertygroup.com.au,aaron@...,howard@...
BOLST_REPORT_RECIPIENT=tom@bolstpropertygroup.com.au
# Evening One Part prompt recipient (Tom replies on this thread).
BOLST_ONE_PART_RECIPIENT=tom@bolstpropertygroup.com.au

# --- LEGACY delegated mode (cloud only): OAuth token cache as a secret ---
# Superseded by the app-only credential above; remove once app-only is live.
# Base64 of .credentials/token.json (MSAL cache from a device-code sign-in):
#   base64 -w0 .credentials/token.json
# setup.sh decodes it back to .credentials/token.json on the VM. It is a
# frozen USER refresh token: it dies on every Tom password reset and can age
# out after ~1 month. Never commit.
# BOLST_GRAPH_TOKEN_JSON_B64=
# Raw fallback (single-line token.json only; B64 wins if both set):
# BOLST_GRAPH_TOKEN_JSON=

# --- Dormant: Domain.com.au API (SUPERSEDED 2026-05-23 by the REA CSV
# path; not used in production). Leave unset. ---
# DOMAIN_CLIENT_ID=
# DOMAIN_CLIENT_SECRET=
